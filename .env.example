# Scufris settings. Copy to .env and adjust. All are optional; defaults shown.
# Environment variables use the SCUFRIS_ prefix.

# Address the dashboard server binds to.
SCUFRIS_HOST=127.0.0.1
SCUFRIS_PORT=8000
# Base URL the scufris MCP tools call back on. Defaults to this server's own
# loopback (http://127.0.0.1:$SCUFRIS_PORT); set it only for a non-loopback
# deployment (e.g. the dashboard reachable at a different host/port than it binds).
# SCUFRIS_API_BASE=http://127.0.0.1:8000

# Path to the built frontend bundle served at "/". Defaults to <repo>/web/dist.
# SCUFRIS_WEB_DIST=web/dist

# Seconds the dashboard waits between /api/stats polls.
SCUFRIS_POLL_SECONDS=2.0

# Where scufris persists runtime state (config overrides set from the settings
# page). Env vars here are the first-boot seed; persisted overrides layer on top.
# SCUFRIS_STATE_DIR=~/.local/state/scufris
# Allow the settings page to change config at runtime. Off = a read-only server
# (the writable-config endpoints return 403). On by default.
SCUFRIS_SETTINGS_WRITABLE=1
# Base directories the Projects page scans one level deep for candidate projects
# (and mkdirs a new project under). Colon-separated or a JSON array. Defaults to
# the sesh set (~/personal, ~/personal/_tests, ~/work, ~/third-party).
# SCUFRIS_PROJECT_BASE_DIRS=~/personal:~/work

# --- Agents ---
# Scufris runs multiple project-bound agents (the /agents page) plus a landing
# orchestrator. Each agent picks a backend ("codex" or "claude") and a permission
# mode (manual|edit|auto, default manual). The settings below configure the
# LANDING orchestrator; per-agent backend/model/mode are set in the UI.
#
# On by default; needs the `codex` CLI (in the dev shell) and a `codex login`.
# Set to 0 to serve the dashboard without the landing chat.
SCUFRIS_AGENT_ENABLED=1
# Landing orchestrator backend: "codex" (default), "claude", "opencode" (a
# self-hosted model via a running `opencode serve` daemon), or "mock" (canned
# offline agent, no login/network - develop or demo the streaming UI). Legacy
# codex mode ids ("app_server"/"exec") are treated as "codex".
SCUFRIS_AGENT_BACKEND=codex
# Default model for CODEX agents (target gpt-5.5; a gpt-5.6 tier if your plan
# exposes it). Empty lets codex pick its configured default.
SCUFRIS_AGENT_MODEL=gpt-5.5
# Default model for CLAUDE agents (override the built-in claude-opus-4-8).
# SCUFRIS_CLAUDE_MODEL=claude-opus-4-8
# The landing orchestrator's write posture: "manual" (read-only), "edit" (may
# edit files), or "auto" (default: edit + run commands - the orchestrator does
# write work unattended; set manual here if too permissive). Project agents
# carry their own; the orchestrator's is a setting (editable from its page).
# SCUFRIS_AGENT_PERMISSION_MODE=auto
# Dev-only: expose the in-process "mock" backend in the agent create picker.
# Off in production (an already-persisted mock agent still runs regardless).
# SCUFRIS_ENABLE_MOCK_BACKEND=0
# Path to the claude CLI + where Claude Code stores sessions (default ~/.claude).
# SCUFRIS_CLAUDE_BIN=claude
# SCUFRIS_CLAUDE_HOME=
# The CODEX auth mode. "chatgpt" = Sign in with ChatGPT subscription; "api_key" =
# API key. Only affects `scufris login`; codex itself holds the auth under
# CODEX_HOME.
SCUFRIS_AGENT_AUTH_MODE=chatgpt
# The CLAUDE auth mode, reported for a claude-backed agent. "claude_ai" = Sign in
# with claude.ai subscription; "api_key" = API key. Reported/effective only - the
# claude CLI holds the real auth (no scufris claude-login flow yet).
SCUFRIS_AGENT_CLAUDE_AUTH_MODE=claude_ai
#
# --- opencode backend (self-hosted llama.cpp) ---
# scufris is a CLIENT of a running `opencode serve` daemon that is itself pointed
# at a llama.cpp server (see examples/opencode/opencode.json). Start the daemon
# with `OPENCODE_CONFIG=examples/opencode/opencode.json opencode serve --port 4096`.
# Base URL of that daemon:
# SCUFRIS_OPENCODE_URL=http://127.0.0.1:4096
# HTTP Basic password if the daemon was started with OPENCODE_SERVER_PASSWORD
# (username is empty). Unset for a loopback dev daemon.
# SCUFRIS_OPENCODE_PASSWORD=
# Default model for OPENCODE agents (a model id the daemon's provider serves).
# SCUFRIS_OPENCODE_MODEL=gemma-4-26B-A4B-it
# The opencode provider id that routes to llama.cpp (from the daemon's config).
# SCUFRIS_OPENCODE_PROVIDER=llamacpp
# The opencode auth mode is always "local" (self-hosted, no login):
# SCUFRIS_AGENT_OPENCODE_AUTH_MODE=local
# Only for api_key auth mode.
# SCUFRIS_OPENAI_API_KEY=sk-...
# Path to the codex binary (defaults to whatever is on PATH).
# SCUFRIS_CODEX_BIN=codex
# Optional: where Codex stores auth/session state (defaults to ~/.codex).
# SCUFRIS_CODEX_HOME=
# Seconds to wait for a codex exec turn.
SCUFRIS_AGENT_TIMEOUT_SECONDS=120.0
# Built-in Scufris tools to hide from the agent, as a JSON list (editable at
# runtime from the settings page). A disabled tool is dropped by the MCP server
# at startup, so it genuinely cannot be called.
# SCUFRIS_DISABLED_TOOLS=["disk_usage"]
