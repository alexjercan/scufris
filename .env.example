# Scufris settings. Copy to .env and adjust. All are optional; defaults shown.
# Environment variables use the SCUFRIS_ prefix.

# Address the dashboard server binds to.
SCUFRIS_HOST=127.0.0.1
SCUFRIS_PORT=8000

# Path to the built frontend bundle served at "/". Defaults to <repo>/web/dist.
# SCUFRIS_WEB_DIST=web/dist

# Seconds the dashboard waits between /api/stats polls.
SCUFRIS_POLL_SECONDS=2.0
