# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env

# Telemetry / dev logs
logs/

.state

# Node / web build (web/dist is covered by dist/ above)
node_modules/
web/dist/

# nix build output symlinks (nix build .#scufris .#scufris-web)
result
result-*

# The scratch database `alembic revision --autogenerate` compares against
# (alembic.ini), so writing a revision never touches an operator's state dir.
.alembic-scratch.db*
